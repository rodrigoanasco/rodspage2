# Public browser key from Clerk. This value is intentionally safe to expose.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only Clerk credentials. Never prefix these with VITE_.
CLERK_SECRET_KEY=sk_test_replace_me
# Optional but recommended: Clerk's PEM public key enables networkless JWT verification.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----"

# The only verified primary email allowed to manage the blog.
BLOG_MANAGER_EMAIL=ro.anasco.s@gmail.com
# Comma-separated exact origins. Replace the production example with your real domain.
BLOG_AUTHORIZED_ORIGINS=http://localhost:5173,https://your-domain.example
# MFA is required unless this is explicitly set to false.
BLOG_REQUIRE_MFA=true

# Existing contact form configuration.
VITE_TURNSTILE_SITE_KEY=replace_me
TURNSTILE_SECRET_KEY=replace_me
EMAILJS_SERVICE_ID=replace_me
EMAILJS_TEMPLATE_ID=replace_me
EMAILJS_PUBLIC_KEY=replace_me
EMAILJS_PRIVATE_KEY=replace_me
